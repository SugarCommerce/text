{
  "name": "sugarcommerce/text",
  "description": "Text for people to read and input made safe to keep: truncation, case, lists and plurals, numbers and percentages, bytes and durations, forgiving search, pagination, and CSV a spreadsheet will not run.",
  "homepage": "https://github.com/sugarcommerce/text/",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "wordpress",
    "text",
    "formatting",
    "humanize",
    "sanitize",
    "input",
    "csv",
    "pagination",
    "search"
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "suggest": {
    "ext-intl": "For numbers, percentages and sizes written in a language other than English, and accent-blind search."
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Text\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Text\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "support": {
    "issues": "https://github.com/sugarcommerce/text/issues",
    "source": "https://github.com/sugarcommerce/text"
  }
}
